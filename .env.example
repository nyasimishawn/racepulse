APP_NAME=RacePulse API
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+psycopg://racepulse:racepulse@localhost:5432/racepulse
REDIS_URL=redis://localhost:6379/0
KEYCLOAK_ENABLED=true
KEYCLOAK_GROUPS_CLAIM=groups
KEYCLOAK_ISSUER_URL=http://localhost:1738/realms/RacePulse
KEYCLOAK_AUDIENCE=RacePulse
KEYCLOAK_SWAGGER_CLIENT_ID=
KEYCLOAK_CLOCK_SKEW_SECONDS=30
KEYCLOAK_ADMIN_REALM_URL=http://localhost:1738/admin/realms/RacePulse
KEYCLOAK_ADMIN_CLIENT_ID=racepulse-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_ADMIN_TIMEOUT_SECONDS=10
KEYCLOAK_PUBLIC_CLIENT_ID=racepulse-desktop
KEYCLOAK_PUBLIC_REDIRECT_URI=http://localhost:14100/callback
KEYCLOAK_PUBLIC_REGISTRATION_ENABLED=false
KEYCLOAK_SEND_VERIFICATION_EMAIL=false
KEYCLOAK_DEFAULT_ROLE=fan
KEYCLOAK_ASSIGNABLE_ROLES=fan,editor,admin
FASTF1_CACHE_PATH=data/fastf1-cache
FASTF1_VERIFY_SSL=true
LOG_LEVEL=INFO
TRUST_PROXY_HEADERS=false
REGISTRATION_RATE_LIMIT=5
REGISTRATION_RATE_WINDOW_SECONDS=3600
EXPENSIVE_REQUEST_RATE_LIMIT=30
EXPENSIVE_REQUEST_RATE_WINDOW_SECONDS=3600
JOB_STREAM_KEY=racepulse:jobs:v1
JOB_CONSUMER_GROUP=racepulse-workers
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=300
JOB_RECOVERY_INTERVAL_SECONDS=30
